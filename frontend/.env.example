VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=false
VITE_SUPABASE_URL=
# Supabase anon / publishable key only (safe for browser exposure). Never use service_role key here.
VITE_SUPABASE_ANON_KEY=
# Local development only: bypasses auth header to send static dev token (default false)
VITE_DEV_AUTH_BYPASS=false
