# ==============================================================================
# Vitrine Frontend Environment Configuration (.env.example)
#
# Standard Setup:
#   cp .env.example .env
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Use client mock adapter (true for standalone frontend testing without backend)
VITE_USE_MOCK=false

# Local development auth bypass (true sends static dev token headers)
VITE_DEV_AUTH_BYPASS=true

# Supabase Client Configuration (Publishable/Anon key only - safe for browser exposure)
VITE_SUPABASE_URL=https://oppirgzizgcqbeunapdu.supabase.co
VITE_SUPABASE_ANON_KEY=
