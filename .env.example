# WS2 Environment Configuration (.env.example)
APP_ENV=dev
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# AI Provider (WS3 - Nebius / Nemotron)
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=

# Research Provider (WS3 - Tavily)
TAVILY_API_KEY=

# Taste Provider (WS3 - Qloo)
QLOO_API_KEY=
QLOO_BASE_URL=
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_CALLS_PER_RUN=20
QLOO_CACHE_TTL_HOURS=24

# Runner & Execution Limits
RUN_MAX_SECONDS=600
STAGE_TIMEOUT_SECONDS=120
MAX_LEADS_PER_RUN=40

# Network & Security
CORS_ORIGINS=http://localhost:5173
