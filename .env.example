# ==============================================================================
# Vitrine Unified Environment Configuration Template (.env.example)
#
# Standard Setup:
#   1. Copy this file to create your local root environment file:
#      cp .env.example .env
#   2. Copy this file into the frontend directory for Vite:
#      cp .env.example frontend/.env
#   3. Populate your live API keys below (or leave blank for fixture/mock mode).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Auth Configuration
# ------------------------------------------------------------------------------
# Application Environment: 'dev', 'test', or 'production'
APP_ENV=dev

# Allow unverified/dev token aliases ('dev-token') in development without full login
ALLOW_DEV_TOKENS=true

# Local SQLite persistence: saves workspace data to a local file (vitrine.db) across restarts.
# In test suites or stateless containers, sqlite+aiosqlite:///:memory: can be used.
DATABASE_URL=sqlite+aiosqlite:///./vitrine.db

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase Backend Configuration
SUPABASE_URL=https://oppirgzizgcqbeunapdu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 2. AI Intelligence Providers (NVIDIA NIM / Nebius OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Provider 1: Deep Reasoning & Outreach Generation (Nemotron-3-Ultra-550B)
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# Provider 2: High-Throughput Extraction & Lead Assessment (Nemotron-3.5-Super-VL-120B)
NEMOTRON_FAST_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_FAST_API_KEY=
NEMOTRON_FAST_MODEL_ID=nvidia/nemotron-3.5-super-vl-120b-a12b

# ------------------------------------------------------------------------------
# 3. Market Research & Web Discovery (Tavily Search API)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Taste Intelligence & Cultural Affinity (Qloo API)
# ------------------------------------------------------------------------------
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_CALLS_PER_RUN=20
QLOO_CACHE_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 5. Pipeline Execution Limits (Optimized for Fast Hackathon Runs)
# ------------------------------------------------------------------------------
STAGE_TIMEOUT_SECONDS=120
MAX_LEADS_PER_RUN=6

# ------------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite - prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK=false
VITE_DEV_AUTH_BYPASS=true
VITE_SUPABASE_URL=https://oppirgzizgcqbeunapdu.supabase.co
VITE_SUPABASE_ANON_KEY=
