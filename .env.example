# WS2 Environment Configuration (.env.example)
# Application Environment (dev, test, production)
APP_ENV=dev

# Allow unverified/dev token aliases strictly in development or automated testing.
# MUST be false in production and for standard local development with real Supabase.
ALLOW_DEV_TOKENS=false

# Supabase Project URL (e.g., https://your-project.supabase.co)
# Required for JWKS fetching of ES256/RS256 asymmetric keys and verifying token issuer (iss).
SUPABASE_URL=

# Supabase Service Role Key (Backend only - admin privileges; NEVER expose to client/frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Optional fallback for HS256 tokens; distinct from frontend anon key)
# Note: Newer Supabase projects use asymmetric signing (ES256), verified via JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Local SQLite persistence: saves workspace data to a local file (vitrine.db) across restarts.
# In test suites or stateless containers, sqlite+aiosqlite:///:memory: can be used.
DATABASE_URL=sqlite+aiosqlite:///./vitrine.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider (WS3 - Nebius / Nemotron)
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# Research Provider (WS3 - Tavily)
TAVILY_API_KEY=

# Taste Provider (WS3 - Qloo)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_CALLS_PER_RUN=20
QLOO_CACHE_TTL_HOURS=24
STAGE_TIMEOUT_SECONDS=120
