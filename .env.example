# WS2 Environment Configuration (.env.example)
APP_ENV=dev
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=sqlite+aiosqlite:///:memory:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider (WS3 - Nebius / Nemotron)
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b

# Research Provider (WS3 - Tavily)
TAVILY_API_KEY=

# Taste Provider (WS3 - Qloo)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_CALLS_PER_RUN=20
QLOO_CACHE_TTL_HOURS=24
STAGE_TIMEOUT_SECONDS=120
